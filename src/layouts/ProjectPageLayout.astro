---
import BaseLayout from "./BaseLayout.astro";
import { Image } from "astro:assets";
import ProjectTitle from "../components/ProjectTitle.astro";
import ImageGrid from "../components/ImageGrid.astro";

const {
    pageTitle,
    projectName,
    year,
    client,
    notableContributions,
    headerImage,
    projectImages,
    isMobile,
    mobileHeaderImages,
} = Astro.props;

const landscapeVariant = isMobile ? "mobile" : "landscape";
---

<BaseLayout pageTitle={pageTitle}>
    <main>
        {
            !isMobile && (
                <Image
                    src={headerImage}
                    alt="Header"
                    class="project-header-image"
                />
            )
        }

        {
            isMobile && (
                <div class="project-header-image-vertical">
                    <ImageGrid
                        images={mobileHeaderImages}
                        imageOrientation={landscapeVariant}
                    />
                </div>
            )
        }

        <ProjectTitle projectName={projectName} year={year} client={client} />

        <section class="project-body">
            <slot />
        </section>
        <br />

        <p style="color: rgb(188, 188, 188)" class="project-body">
            Notable Contributions
        </p>
        {
            notableContributions.length > 0 && (
                <ul class="project-body">
                    {notableContributions.map((item: unknown) => (
                        <li>{item}</li>
                    ))}
                </ul>
            )
        }
        <br />
        <br />
        <ImageGrid images={projectImages} imageOrientation={landscapeVariant} />
    </main>
</BaseLayout>
