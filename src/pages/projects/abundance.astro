---
const pageTitle = "Nina Demirjian - Abundance";
export const projectName = "Abundance";
export const year = "2018";
const client = "American Museum of Natural History";
const notableContributions = [
    "Implemented a 2d flocking algorithm for fish movement behavior.",
    "Integrated the OpenKinect library for processing to track user blob data.",
];

import "../../styles/global.css";
import ProjectPageLayout from "../../layouts/ProjectPageLayout.astro";

import abundance_gif_00 from "../../assets/abundance/abundance_00.gif";
import abundance_gif_01 from "../../assets/abundance/abundance_01.gif";

import abundance_00 from "../../assets/abundance/abundance_00.png";


const images = [
    abundance_gif_00,
    abundance_00,
];

export const orderInList = 0;
export const tags = ["installation"]

---

<ProjectPageLayout
    pageTitle={pageTitle}
    projectName={projectName}
    year={year}
    client={client}
    notableContributions={notableContributions}
    projectImages={images}
    headerImage={abundance_gif_01}
>
    <p>
        Abundance is a large interactive floor projection depicting a flock of
        abstract fish. It was built in Processing and uses a Kinect is used to
        track movement of visitors in the gallery space. Schools of fish flock
        and swim together in a circle, but will swim away from tracked visitors.
        <br /><br />
        The piece was a part of the American Museum of Natural History’s special exhibition,
        Unseen Oceans, which opened in early March of 2018. The exhibit has since
        traveled to other museums across the country.
        <br /><br />
        I worked with one other developer to create the Abundance installation.
    </p>
</ProjectPageLayout>
