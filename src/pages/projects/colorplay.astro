---
const pageTitle = "Nina Demirjian - Color Play";
export const projectName = "Color Play";
export const year = "2020";
const client = "American Museum of Natural History";
const notableContributions = [
  "Created lightweight particle systems and VFX graphs that changed color at runtime from user input. The effects would populate at positions on the screen according to user position data from the Kinect.",
  "Modified compute shaders to take in user position data and update visuals accordingly. The resulting effect allowed users to “push” color around the screen with their hands."
];

import "../../styles/global.css";
import ProjectPageLayout from "../../layouts/ProjectPageLayout.astro";

import colorplay_00 from "../../assets/colorplay/colorplay_00.png";
import colorplay_01 from "../../assets/colorplay/colorplay_01.png";
import colorplay_02 from "../../assets/colorplay/colorplay_02.png";
import colorplay_03 from "../../assets/colorplay/colorplay_03.png";
import colorplay_04 from "../../assets/colorplay/colorplay_04.png";
import colorplay_05 from "../../assets/colorplay/colorplay_05.png";
import colorplay_06 from "../../assets/colorplay/colorplay_06.png";
import colorplay_07 from "../../assets/colorplay/colorplay_07.png";
import colorplay_gif_00 from "../../assets/colorplay/colorplay_00.gif";

const images = [
    colorplay_01,
    colorplay_gif_00,
    colorplay_02,
    colorplay_03,
    colorplay_04,
    colorplay_05,
    colorplay_06,
    colorplay_07,
];

export const orderInList = 2;
export const tags = ["installation"]
---

<ProjectPageLayout
    pageTitle={pageTitle}
    projectName={projectName}
    year={year}
    client={client}
    notableContributions={notableContributions}
    projectImages={images}
    headerImage={colorplay_00}
>
    <p>
        Color Play is an interactive installation developed in Unity. Users
        interact with a set of 4 visual scenes projected on the wall and floor
        to experiment with color. An Xbox Kinect detects user motion to effect
        dynamic visuals on the projected screens. A separate touch screen kiosk
        gives users the ability to modify colors used in the visuals.
        <br /><br />
        Color Play was a part of the American Museum of Natural History’s special
        exhibition, The Nature of Color, which opened in early March 2020.
        <br /><br />
        I worked on a small team in Unity to create visuals and functionality for
        Color Play.
    </p>
</ProjectPageLayout>
