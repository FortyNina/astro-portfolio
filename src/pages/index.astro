---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "Nina Demirjian";

type ProjectModule = {
  projectName?: string;
  orderInList?: number;
  year?: string;
  tags?: [];
};

const projectPages = import.meta.glob<ProjectModule>("./projects/*.astro", {
  eager: true,
});
---

<BaseLayout pageTitle={pageTitle}>
  <!-- Centering wrapper -->
  <div
    style="
      display: flex;
      justify-content: center; 
      align-items: flex-start;
      padding: 2rem;
      margin-top: 13%;
    "
  >
    <div
      style="
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
        align-items: flex-start;
        max-width: 1200px;
        width: 100%;
      "
    >
      <div style="flex: 1 1 400px; max-width: 600px;">
        <iframe
          src="https://www.youtube.com/embed/hmTaXDmlmLY?autoplay=1&mute=1"
          title="YouTube video player"
          frameborder="0"
          allow="autoplay; encrypted-media; picture-in-picture"
          allowfullscreen
          width="100%"
          height="315"></iframe>
      </div>

      <div class="project-list" style="flex: 1 1 300px; min-width: 250px;">
        {
          Object.entries(projectPages)
            .map(([path, module]) => {
              const slug = path
                .replace("./projects/", "")
                .replace(".astro", "");
              return {
                slug,
                title: module.projectName ?? slug,
                order: module.orderInList ?? 999,
                year: module.year ?? "",
                tags: module.tags ?? [],
              };
            })
            .sort((a, b) => b.order - a.order)
            .map(({ slug, title, order, year, tags }) => (
              <a href={`/projects/${slug}`} class="project-link">
                {year ? `${year}. ` : ""}
                {title.toUpperCase()}
                {tags.length ? (
                  <span class="project-tags">({tags.join(", ")})</span>
                ) : (
                  ""
                )}
              </a>
            ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
